<h1>マイプロフィール</h1>

<% if notice %>
  <p><%= notice %></p>
<% end %>

<p>ユーザーID：<%= @user.uid %></p>
<p>表示名：<%= @user.name.presence || "未設定" %></p>

<h2>自己紹介</h2>
<p><%= simple_format(@user.bio.presence || "未設定") %></p>

<p><%= link_to "プロフィールを編集", edit_profile_path %></p>
<p><%= link_to "投稿一覧に戻る", root_path %></p>
