<% if flash[:notice] %>
  <p><%= flash[:notice] %></p>
<% end %>

<% if flash[:alert] %>
  <p><%= flash[:alert] %></p>
<% end %>

<h1>本管理アプリ</h1>

<p>
  <%= link_to "新規登録", new_book_path %>
</p>

<table border="1">
  <tr>
    <th>タイトル</th>
    <th>著者</th>
    <th>ジャンル</th>
    <th>操作</th>
  </tr>

  <% @books.each do |book| %>
    <tr>
      <td><%= book.title %></td>
      <td><%= book.author %></td>
      <td><%= book.genre %></td>
      <td>
        <%= link_to "詳細", book_path(book) %>
        <%= link_to "編集", edit_book_path(book) %>
        <%= button_to "削除", book_path(book),
            method: :delete,
            data: { turbo_confirm: "削除しますか？" },
            form: { style: "display:inline;" } %>
      </td>
    </tr>
  <% end %>
</table>