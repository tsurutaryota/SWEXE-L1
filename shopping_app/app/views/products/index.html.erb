<h1>商品一覧</h1>

<p><%= link_to "商品を登録する", new_product_path %></p>
<p><%= link_to "カートを見る", cart_path(current_cart) %></p>

<% if notice %>
  <p><%= notice %></p>
<% end %>

<table border="1" cellpadding="8">
  <thead>
    <tr>
      <th>商品名</th>
      <th>価格</th>
      <th>操作</th>
    </tr>
  </thead>
  <tbody>
    <% @products.each do |product| %>
      <tr>
        <td><%= product.name %></td>
        <td><%= number_to_currency(product.price, unit: "円", precision: 0, format: "%n%u") %></td>
        <td>
          <%= button_to "カートに追加", cart_items_path(product_id: product.id), method: :post %>
          <%= button_to "削除", product_path(product), method: :delete,
              form: { data: { turbo_confirm: "この商品を削除しますか？" } } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
